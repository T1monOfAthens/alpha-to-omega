"11":{"position":[[0,2]]},"13":{"position":[[0,2]]},"25":{"position":[[0,2]]}}}],["题解",{"_index":14,"t":{"13":{"position":[[14,2]]}}}],["首先",{"_index":16,"t":{"15":{"position":[[0,2]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":2,"t":"这里整理数据结构相关知识。","s":"数据结构","u":"/alpha-to-omega/docs/data-structure/intro/","h":"","p":1},{"i":4,"t":"这里整理动态规划相关知识。","s":"动态规划","u":"/alpha-to-omega/docs/dp/intro/","h":"","p":3},{"i":6,"t":"这里整理计算几何相关知识。","s":"计算几何","u":"/alpha-to-omega/docs/geometry/intro/","h":"","p":5},{"i":8,"t":"这里整理图论相关知识。","s":"图论","u":"/alpha-to-omega/docs/graph/intro/","h":"","p":7},{"i":10,"t":"这里整理数学相关知识。","s":"数学","u":"/alpha-to-omega/docs/math/intro/","h":"","p":9},{"i":12,"t":"这里整理杂项相关知识。","s":"杂项","u":"/alpha-to-omega/docs/misc/intro/","h":"","p":11},{"i":14,"t":"这里整理 OI / ACM 题解与相关资料。","s":"题解","u":"/alpha-to-omega/docs/solutions/intro/","h":"","p":13},{"i":16,"t":"首先，我们考虑第一件事，把两个标记分开存。 我们开 add[p],mul[p] 分别存两个标记。 假设我们现在发生了两个操作：+3,×2+3,\\times 2+3,×2。 (x+3)×2=2x+6(x+3) \\times 2 = 2x + 6(x+3)×2=2x+6 而不是 2x+32x+32x+3。 注意到一个事情，就是乘法还会改变之前欠着的加法。 我们直接考虑把两个标记写成一个式子： x→x×mul+addx \\to x \\times mul + addx→x×mul+add 这里我们要注意一个事情：x→x×1+0x \\to x \\times 1 + 0x→x×1+0，所以在什么都没有发生的时候，或者是我们清空标记的时候： mul[p] = 1; add[p] = 0;","s":"P3373 【模板】线段树 2","u":"/alpha-to-omega/docs/solutions/p3373-segment-tree-2/","h":"","p":15},{"i":18,"t":"x→x×m+ax→x×m+a+kx \\to x \\times m + a\\\\ x \\to x \\times m + a + kx→x×m+ax→x×m+a+k 这俩式子是不是就是把加法标记从 aaa 变成了 (a+k)(a+k)(a+k)。所以我们只需要修改加法标记就行了： add[p] += k;","s":"加法","u":"/alpha-to-omega/docs/solutions/p3373-segment-tree-2/","h":"#加法","p":15},{"i":20,"t":"在乘一个 kkk： (x×m+a)×kx×(mk)+ak(x \\times m + a) \\times k \\\\ x\\times(mk) + ak(x×m+a)×kx×(mk)+ak 所以我们发现，乘法标记被乘 kkk，加法标记也被乘 kkk。 所以： tree[p] = tree[p] * k % MOD; mul[p] = mul[p] * k % MOD; add[p] = add[p] * k % MOD;","s":"乘法","u":"/alpha-to-omega/docs/solutions/p3373-segment-tree-2/","h":"#乘法","p":15},{"i":22,"t":"假设儿子有自己的标记： x→x×mc+acx \\to x \\times m_c + a_cx→x×mc​+ac​ 父亲还有标记： x→x×mp+apx \\to x \\times m_p + a_px→x×mp​+ap​ 如果这个时候，父亲要下放标记了，会发生什么。 注意操作顺序：儿子欠的操作先发生，父亲后来的操作再发生： (xmc+ac)mp+ap(xm_c + a_c)m_p + a_p(xmc​+ac​)mp​+ap​ 整理一下这个式子： x(mcmp)+(acmp+ap)x(m_cm_p) + (a_cm_p + a_p)x(mc​mp​)+(ac​mp​+ap​) 所以合并之后：mc=mc×mp,ac=ac×mp+apm_c = m_c \\times m_p,a_c = a_c \\times m_p + a_pmc​=mc​×mp​,ac​=ac​×mp​+ap​。","s":"合并懒标记","u":"/alpha-to-omega/docs/solutions/p3373-segment-tree-2/","h":"#合并懒标记","p":15},{"i":24,"t":"线段树假设你要维护 nnn 个元素，数组长度开四倍。 #include<bits/stdc++.h> using namespace std; #define int long long const int N=1e5+5; int n,m,mod; int a[N]; int tree[N*4]; int add[N*4]; int mul[N*4]; void pushUp(int p) { tree[p] = (tree[p * 2] + tree[p * 2 + 1]) % mod; } void build(int p,int l,int r) { mul[p] = 1; add[p] = 0; if (l == r) { tree[p] = a[l] % mod; return; } int mid = (l + r) / 2; build(p * 2, l, mid); build(p * 2 + 1, mid + 1, r); pushUp(p); } void pushDown(int p,int l,int r) { if (mul[p] == 1 && add[p] == 0) return; int mid = (l + r) / 2; int ls = p * 2; int rs = p * 2 + 1; int lenL = mid - l + 1; int lenR = r - mid; // 先修改两个儿子的区间和 tree[ls] = (tree[ls] * mul[p] + add[p] * lenL) % mod; tree[rs] = (tree[rs] * mul[p] + add[p] * lenR) % mod; // 再合并两个儿子的 lazy 标记 mul[ls] = mul[ls] * mul[p] % mod; mul[rs] = mul[rs] * mul[p] % mod; add[ls] = (add[ls] * mul[p] + add[p]) % mod; add[rs] = (add[rs] * mul[p] + add[p]) % mod; // 父亲标记清空 mul[p] = 1; add[p] = 0; } // 区间乘 k void updateMul(int p,int l,int r,int L,int R,int k) { if (L <= l && r <= R) { tree[p] = tree[p] * k % mod; mul[p] = mul[p] * k % mod; add[p] = add[p] * k % mod; return; } pushDown(p, l, r); int mid = (l + r) / 2; if (L <= mid) { updateMul(p * 2, l, mid, L, R, k); } if (R > mid) { updateMul(p * 2 + 1, mid + 1, r, L, R, k); } pushUp(p); } // 区间加 k void updateAdd(int p,int l,int r,int L,int R,int k) { if (L <= l && r <= R) { tree[p] = (tree[p] + k * (r - l + 1)) % mod; add[p] = (add[p] + k) % mod; return; } pushDown(p, l, r); int mid = (l + r) / 2; if (L <= mid) { updateAdd(p * 2, l, mid, L, R, k); } if (R > mid) { updateAdd(p * 2 + 1, mid + 1, r, L, R, k); } pushUp(p); } // 区间求和 int query(int p,int l,int r,int L,int R) { if (L <= l && r <= R) { return tree[p]; } pushDown(p, l, r); int mid = (l + r) / 2; int ans = 0; if (L <= mid) { ans += query(p * 2, l, mid, L, R); ans %= mod; } if (R > mid) { ans += query(p * 2 + 1, mid + 1, r, L, R); ans %= mod; } return ans; } signed main() { cin >> n >> m >> mod; for (int i = 1; i <= n; i++) { cin >> a[i]; } build(1, 1, n); while (m--) { int op; cin >> op; if (op == 1) { int x, y, k; cin >> x >> y >> k; updateMul(1, 1, n, x, y, k % mod); } else if (op == 2) { int x, y, k; cin >> x >> y >> k; updateAdd(1, 1, n, x, y, k % mod); } else { int x, y; cin >> x >> y; cout << query(1, 1, n, x, y) % mod << '\\n'; } } return 0; }","s":"注意","u":"/alpha-to-omega/docs/solutions/p3373-segment-tree-2/","h":"#注意","p":15},{"i":26,"t":"这里整理字符串相关知识。","s":"字符串","u":"/alpha-to-omega/docs/string/intro/","h":"","p":25}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/2",[0,0.624,1,0.624,2,3.594,3,0.803,4,1.004]],["t/4",[0,0.618,1,0.618,3,0.795,4,0.995,5,3.559,6,3.559]],["t/6",[0,0.618,1,0.618,3,0.795,4,0.995,7,3.559,8,3.559]],["t/8",[0,0.624,1,0.624,3,0.803,4,1.004,9,3.594]],["t/10",[0,0.624,1,0.624,3,0.803,4,1.004,10,3.594]],["t/12",[0,0.624,1,0.624,3,0.803,4,1.004,11,3.594]],["t/14",[0,0.612,1,0.612,3,0.788,12,3.525,13,3.525,14,3.525,15,3.525]],["t/16",[0,0.299,16,1.72,17,2.329,18,2.548,19,1.72,20,1.72,21,2.589,22,1.404,23,1.72,24,2.548,25,1.327,26,1.542,27,1.404,28,2.224,29,1.72,30,1.068,31,1.72,32,1.966,33,1.327,34,3.884,35,2.895,36,1.705,37,1.759,38,3.356,39,3.036,40,1.72,41,2.548,42,1.966,43,2.341,44,2.548,45,1.327,46,1.327,47,1.327,48,1.72,49,1.72,50,1.327,51,1.068,52,1.72,53,1.72,54,1.068,55,2.548,56,1.068,57,2.589,58,2.548,59,1.966,60,0.874,61,1.327,62,1.72,63,1.72,64,1.966,65,1.72,66,1.327]],["t/18",[17,